# === Telegram Bot ===
BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_USER_ID=your_telegram_user_id_here
# Username бота без @ — для Telegram Login Widget на сайте
BOT_USERNAME=Kr1saLVacancyBot
# Срок жизни сессии в браузере после Telegram Login (дней)
SESSION_MAX_AGE_DAYS=30

# === OpenRouter (https://openrouter.ai/keys) ===
OPENROUTER_API_KEY=your_openrouter_api_key_here

# === Anti-spam / polling ===
MESSAGE_DELAY_SECONDS=15
CHECK_INTERVAL_MIN_SECONDS=60
CHECK_INTERVAL_MAX_SECONDS=300

# === Mini App / FastAPI ===
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
# Публичный HTTPS URL (cloudflared / ngrok / hosting) — иначе кнопка Mini App скрыта
WEBAPP_PUBLIC_URL=
# Секрет для локального доступа к API без Telegram (curl/браузер).
# Оставь пустым — тогда localhost без Telegram initData тоже отклоняется.
WEBAPP_LOCAL_TOKEN=

# === Публичные Telegram-каналы (через t.me/s/, без api_id/api_hash) ===
TG_CHANNELS=mobiledevjob,dartlang_jobs,forallmobile

# === Фильтрация вакансий (для TG / Djinni / Gmail) ===
# Хоть одно совпадение из VACANCY_KEYWORDS должно быть в тексте.
# `мобильн` покрывает все падежи слова «мобильный/мобильного/мобильных…»
VACANCY_KEYWORDS=flutter,dart,mobile developer,mobile-разработчик,мобильн
# Стоп-слова: если хоть одно совпадает — вакансия отбрасывается.
# Пример чтобы срезать сеньорские: VACANCY_STOPWORDS=senior only,teamlead,lead engineer
VACANCY_STOPWORDS=

# === Gmail IMAP ===
# 1) Включи 2-Step Verification: https://myaccount.google.com/security
# 2) Создай App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_LOOKBACK_DAYS=3
